{
  "name": "legend-of-the-looper",
  "private": true,
  "type": "module",
  "description": "The Legend of the Looper — a 140-second handscroll and shadow-puppet legend rendered in canvas with a synthesized score and neural narration.",
  "scripts": {
    "narration": "node tools/make-narration.mjs",
    "render": "node render.mjs",
    "render:draft": "node render.mjs --fps 30 --workers 5 --out out/legend-of-the-looper-draft.mp4",
    "mix": "node render.mjs --mix-only",
    "stills": "node render.mjs --stills 2.5,6,9,13.8,21,26.5,33,38,46.5,49.5,55.5,62,67.8,74.5,81.5,84,87.9,95.6,101.5,110.5,113.5,117.8,123.5,126.9,131.5,137.5"
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
